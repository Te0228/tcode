# 放哪儿(优先级从高到低,见 spec §8.2):
#   1. 真实环境变量           —— 一次性覆盖,如 PROVIDER=anthropic tcode
#   2. <项目根目录>/.env      —— 只对这个项目生效
#   3. ~/.tcode/.env          —— 全局默认,推荐把 API key 放这里
# 全局装了 tcode 之后,把这个文件复制成 ~/.tcode/.env 填上 key 即可,
# 不需要每个项目放一份,也不需要往 ~/.zshrc 里 export API key。

PROVIDER=anthropic
# 当前生效的 provider,对应 src/llm/providers.ts 里的 key,默认 anthropic

ANTHROPIC_API_KEY=sk-ant-xxxxx
# Optional, defaults to claude-sonnet-5
ANTHROPIC_MODEL=claude-sonnet-5
# Optional, custom gateway/base url
ANTHROPIC_BASE_URL=

DEEPSEEK_API_KEY=sk-xxxxx
# Optional, defaults to deepseek-chat
DEEPSEEK_MODEL=deepseek-chat
# Optional, defaults to https://api.deepseek.com
DEEPSEEK_BASE_URL=

# Optional, max tool-call iterations per turn
MAX_TOOL_ITERATIONS=50
# Optional, bash tool timeout in ms
COMMAND_TIMEOUT_MS=60000
